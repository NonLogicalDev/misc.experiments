# Standard Library
import os
import random
import string
import subprocess as sp
from pathlib import Path

# Third Party
import click
from pydantic import BaseModel

USER_NAME = "oleg.utkin"
TRACE_COMMANDS = os.environ.get("GIT_MONO_TRACE", "0") == "1"

# ------------------------------------------------------------
# Models
# ------------------------------------------------------------

class GitBranchInfo(BaseModel):
    name: str
    sha: str
    new_commits: list[str]

# ------------------------------------------------------------

@click.group()
def main():
    """Main entry point for git-mono script."""
    pass


@main.command()
@click.argument("branch", type=str)
def show_new_commits(branch: str):
    git = GitOps.new_from_dir(Path(os.getcwd()))
    branch_info = git.get_branch_info(branch)
    click.echo(f"New commits on {branch}: {branch_info.new_commits}")

@main.command()
def branch_tree():
    """Display a tree of branches based on their upstream relationships."""
    git = GitOps.new_from_dir(Path(os.getcwd()))
    tree = git.build_branch_tree()
    git.print_branch_tree(tree)

@main.command()
@click.argument("name", type=str)
def new(name: str):
    """Create a new branch with format {USER_NAME}/{name}@{random_5_chars}."""
    git = GitOps.new_from_dir(Path(os.getcwd()))

    git.ensure_clean()

    current_branch_info = git.get_branch_info("HEAD")

    # Generate random 5 lowercase alphanumeric chars
    random_suffix = ''.join(random.choices(string.ascii_lowercase + string.digits, k=5))
    new_branch_name = f"{USER_NAME}/{name}@{random_suffix}"

    click.echo(f"Creating new branch: {new_branch_name}")
    git.make_new_branch(new_branch_name, 'HEAD', force=False)

    click.echo(f"Setting upstream to {current_branch_info.name}")
    git.set_branch_upstream(new_branch_name, current_branch_info.name)

    click.echo(f"Switching to {new_branch_name}")
    git.switch_to_branch(new_branch_name)

    click.echo(f"✓ Created and switched to branch: {new_branch_name}")

@main.command()
@click.argument("target_branch", type=str)
@click.option("--branch", "-b", type=str, default=None, help="Branch to reparent (defaults to current branch)")
def branch_reparent(target_branch: str, branch: str):
    """Change the upstream of a branch to a new target branch."""
    git = GitOps.new_from_dir(Path(os.getcwd()))

    # Determine which branch to reparent
    if branch is None:
        branch_to_reparent = git._run_output(["git", "rev-parse", "--abbrev-ref", "HEAD"])
        click.echo(f"Reparenting current branch: {branch_to_reparent}")
    else:
        branch_to_reparent = branch
        click.echo(f"Reparenting branch: {branch_to_reparent}")

    # Validate target branch exists
    try:
        git.validate_commit_exists(target_branch)
    except RuntimeError:
        raise click.ClickException(f"Target branch does not exist: {target_branch}")

    # Get current upstream if any
    try:
        old_upstream = git._run_output(["git", "rev-parse", "--abbrev-ref", f"{branch_to_reparent}@{{upstream}}"])
        click.echo(f"Current upstream: {old_upstream}")
    except sp.CalledProcessError:
        click.echo("Current upstream: (none)")

    # Set new upstream
    click.echo(f"Setting new upstream to: {target_branch}")
    git.set_branch_upstream(branch_to_reparent, target_branch)

    click.echo(f"✓ Successfully reparented {branch_to_reparent} to {target_branch}")


## git-mono push-branch $PUSH_BRANCH
# is a helper script that will
#  * find new commits on the $PUSH_BRANCH (using merge-base)
#  * create a new temporary branch from the current head and call it ${PUSH_BRANCH}@@push-branch
#  * check out the newly created branch
#  * cherry-pick the new commits from $PUSH_BRANCH to the newly created branch
#  * once all commits are cherry-picked, point the $PUSH_BRANCH to the current head
#  * checkout the $PUSH_BRANCH
#  * delete the temporary branch
@main.command()
@click.argument("push_branch", type=str)
def push_branch(push_branch: str):
    git = GitOps.new_from_dir(Path(os.getcwd()))

    git.ensure_clean()

    current_branch_info = git.get_branch_info("HEAD")

    push_branch_info = git.get_branch_info(push_branch)
    temp_branch_name = f"{push_branch}@@push-branch-wip"
    if len(push_branch_info.new_commits) == 0:
        click.echo(f"No new commits found on {push_branch}")
        return

    click.echo(f"New commits found on {push_branch}: {push_branch_info.new_commits}")

    click.echo(f"Creating temporary branch... {temp_branch_name}")
    git.make_new_branch(temp_branch_name, current_branch_info.sha, force=True)

    click.echo(f"Switching to temporary branch... {temp_branch_name}")
    git.switch_to_branch(temp_branch_name)

    click.echo(f"Cherry-picking commits... {push_branch_info.new_commits}")
    git.cherry_pick_commits(push_branch_info.new_commits)

    click.echo(f"Pointing {push_branch} to HEAD... {push_branch}")
    git.make_new_branch(push_branch, 'HEAD', force=True)

    click.echo(f"Switching to {push_branch}... {push_branch}")
    git.switch_to_branch(push_branch)

    click.echo(f"Pointing upstream for {push_branch} to {current_branch_info.sha}... {push_branch}")
    git.set_branch_upstream(push_branch, current_branch_info.name)

    click.echo(f"Deleting temporary branch... {temp_branch_name}")
    git.delete_branch(temp_branch_name)


# git-mono push-sha $BRANCH_NAME $COMMIT_SHA [--force]
# is a helper script that will
#  * validate commit_sha exists
#  * create a new branch from current HEAD (error if already exists, unless --force)
#  * set upstream to current branch
#  * switch to the new branch
#  * merge the commit onto the branch:
#    - if no conflicts: commit with original metadata (same as cherry-pick)
#    - if conflicts: create empty commit with original metadata, leave index/worktree in conflict state
#      user can resolve conflicts and use 'git commit --amend' to finalize
@main.command()
@click.argument("branch_name", type=str)
@click.argument("commit_sha", type=str)
@click.option("--force", is_flag=True, default=False, help="Overwrite branch if it already exists")
def push_sha(branch_name: str, commit_sha: str, force: bool):
    git = GitOps.new_from_dir(Path(os.getcwd()))

    git.ensure_clean()

    current_branch_info = git.get_branch_info("HEAD")

    click.echo(f"Validating commit SHA... {commit_sha}")
    git.validate_commit_exists(commit_sha)

    click.echo(f"Creating new branch from HEAD... {branch_name}")
    git.make_new_branch(branch_name, 'HEAD', force=force)

    click.echo(f"Setting upstream for {branch_name} to {current_branch_info.name}")
    git.set_branch_upstream(branch_name, current_branch_info.name)

    click.echo(f"Switching to branch... {branch_name}")
    git.switch_to_branch(branch_name)

    click.echo(f"Merging commit {commit_sha}...")
    git.merge_commit_with_soft_conflicts(commit_sha)


# git-mono push-stg-patch $PATCH_NAME [--force] [--branch BRANCH]
# is a helper script that will
#  * use stg id to get the commit SHA for the patch
#  * call push-sha logic with patch name as branch name
@main.command()
@click.argument("patch_name", type=str)
@click.option("--force", is_flag=True, default=False, help="Overwrite branch if it already exists")
@click.option("--branch", "-b", type=str, default=None, help="Stacked git branch to get patch from")
def push_stg_patch(patch_name: str, force: bool, branch: str):
    git = GitOps.new_from_dir(Path(os.getcwd()))

    # Get commit SHA from stacked git
    if branch:
        click.echo(f"Getting commit SHA for patch {patch_name} from branch {branch}...")
    else:
        click.echo(f"Getting commit SHA for patch {patch_name}...")

    commit_sha = git.get_stg_patch_sha(patch_name, branch)
    click.echo(f"Found commit SHA: {commit_sha}")

    # Reuse push-sha logic
    git.ensure_clean()

    # Create new branch name '${USER_NAME}/${patch-name}'
    new_branch_name = f"{USER_NAME}/{patch_name}"

    current_branch_info = git.get_branch_info("HEAD")

    click.echo(f"Validating commit SHA... {commit_sha}")
    git.validate_commit_exists(commit_sha)

    click.echo(f"Creating new branch from HEAD... {new_branch_name}")
    git.make_new_branch(new_branch_name, 'HEAD', force=force)

    click.echo(f"Setting upstream for {new_branch_name} to {current_branch_info.name}")
    git.set_branch_upstream(new_branch_name, current_branch_info.name)

    click.echo(f"Switching to branch... {new_branch_name}")
    git.switch_to_branch(new_branch_name)

    click.echo(f"Merging commit {commit_sha}...")
    git.merge_commit_with_soft_conflicts(commit_sha)


