@main.command()
@click.argument("name", type=str)
def new(name: str):
    """Create a new branch with format {USER_NAME}/{name}@{random_5_chars}."""
    git = GitOps.new_from_dir(Path(os.getcwd()))

    git.ensure_clean()

    current_branch_info = git.get_branch_info("HEAD")

    # Generate random 5 lowercase alphanumeric chars
    random_suffix = ''.join(random.choices(string.ascii_lowercase + string.digits, k=5))
    new_branch_name = f"{USER_NAME}/{name}@{random_suffix}"

    click.echo(f"Creating new branch: {new_branch_name}")
    git.make_new_branch(new_branch_name, 'HEAD', force=False)

    click.echo(f"Setting upstream to {current_branch_info.name}")
    git.set_branch_upstream(new_branch_name, current_branch_info.name)

    click.echo(f"Switching to {new_branch_name}")
    git.switch_to_branch(new_branch_name)

    click.echo(f"✓ Created and switched to branch: {new_branch_name}")

@main.command()
@click.argument("target_branch", type=str)
@click.option("--branch", "-b", type=str, default=None, help="Branch to reparent (defaults to current branch)")
def branch_reparent(target_branch: str, branch: str):
    """Change the upstream of a branch to a new target branch."""
    git = GitOps.new_from_dir(Path(os.getcwd()))

    # Determine which branch to reparent
    if branch is None:
        branch_to_reparent = git._run_output(["git", "rev-parse", "--abbrev-ref", "HEAD"])
        click.echo(f"Reparenting current branch: {branch_to_reparent}")
    else:
        branch_to_reparent = branch
        click.echo(f"Reparenting branch: {branch_to_reparent}")

    # Validate target branch exists
    try:
        git.validate_commit_exists(target_branch)
    except RuntimeError:
        raise click.ClickException(f"Target branch does not exist: {target_branch}")

    # Get current upstream if any
    try:
        old_upstream = git._run_output(["git", "rev-parse", "--abbrev-ref", f"{branch_to_reparent}@{{upstream}}"])
        click.echo(f"Current upstream: {old_upstream}")
    except sp.CalledProcessError:
        click.echo("Current upstream: (none)")

    # Set new upstream
    click.echo(f"Setting new upstream to: {target_branch}")
    git.set_branch_upstream(branch_to_reparent, target_branch)

    click.echo(f"✓ Successfully reparented {branch_to_reparent} to {target_branch}")


## git-mono push-branch $PUSH_BRANCH
# is a helper script that will
#  * find new commits on the $PUSH_BRANCH (using merge-base)
#  * create a new temporary branch from the current head and call it ${PUSH_BRANCH}@@push-branch
#  * check out the newly created branch
#  * cherry-pick the new commits from $PUSH_BRANCH to the newly created branch
#  * once all commits are cherry-picked, point the $PUSH_BRANCH to the current head
#  * checkout the $PUSH_BRANCH
#  * delete the temporary branch
@main.command()
@click.argument("push_branch", type=str)
def push_branch(push_branch: str):
    git = GitOps.new_from_dir(Path(os.getcwd()))

    git.ensure_clean()

    current_branch_info = git.get_branch_info("HEAD")

    push_branch_info = git.get_branch_info(push_branch)
    temp_branch_name = f"{push_branch}@@push-branch-wip"
    if len(push_branch_info.new_commits) == 0:
        click.echo(f"No new commits found on {push_branch}")
        return

    click.echo(f"New commits found on {push_branch}: {push_branch_info.new_commits}")

    click.echo(f"Creating temporary branch... {temp_branch_name}")
    git.make_new_branch(temp_branch_name, current_branch_info.sha, force=True)

    click.echo(f"Switching to temporary branch... {temp_branch_name}")
    git.switch_to_branch(temp_branch_name)

    click.echo(f"Cherry-picking commits... {push_branch_info.new_commits}")
    git.cherry_pick_commits(push_branch_info.new_commits)

    click.echo(f"Pointing {push_branch} to HEAD... {push_branch}")
    git.make_new_branch(push_branch, 'HEAD', force=True)

    click.echo(f"Switching to {push_branch}... {push_branch}")
    git.switch_to_branch(push_branch)

    click.echo(f"Pointing upstream for {push_branch} to {current_branch_info.sha}... {push_branch}")
    git.set_branch_upstream(push_branch, current_branch_info.name)

    click.echo(f"Deleting temporary branch... {temp_branch_name}")
    git.delete_branch(temp_branch_name)


# git-mono push-sha $BRANCH_NAME $COMMIT_SHA [--force]
# is a helper script that will
#  * validate commit_sha exists
#  * create a new branch from current HEAD (error if already exists, unless --force)
#  * set upstream to current branch
#  * switch to the new branch
#  * merge the commit onto the branch:
#    - if no conflicts: commit with original metadata (same as cherry-pick)
#    - if conflicts: create empty commit with original metadata, leave index/worktree in conflict state
#      user can resolve conflicts and use 'git commit --amend' to finalize
@main.command()
@click.argument("branch_name", type=str)
@click.argument("commit_sha", type=str)
@click.option("--force", is_flag=True, default=False, help="Overwrite branch if it already exists")
def push_sha(branch_name: str, commit_sha: str, force: bool):
    git = GitOps.new_from_dir(Path(os.getcwd()))

    git.ensure_clean()

    current_branch_info = git.get_branch_info("HEAD")

    click.echo(f"Validating commit SHA... {commit_sha}")
    git.validate_commit_exists(commit_sha)

    click.echo(f"Creating new branch from HEAD... {branch_name}")
    git.make_new_branch(branch_name, 'HEAD', force=force)

    click.echo(f"Setting upstream for {branch_name} to {current_branch_info.name}")
    git.set_branch_upstream(branch_name, current_branch_info.name)

    click.echo(f"Switching to branch... {branch_name}")
    git.switch_to_branch(branch_name)

    click.echo(f"Merging commit {commit_sha}...")
    git.merge_commit_with_soft_conflicts(commit_sha)


# git-mono push-stg-patch $PATCH_NAME [--force] [--branch BRANCH]
# is a helper script that will
#  * use stg id to get the commit SHA for the patch
#  * call push-sha logic with patch name as branch name
@main.command()
@click.argument("patch_name", type=str)
@click.option("--force", is_flag=True, default=False, help="Overwrite branch if it already exists")
@click.option("--branch", "-b", type=str, default=None, help="Stacked git branch to get patch from")
def push_stg_patch(patch_name: str, force: bool, branch: str):
    git = GitOps.new_from_dir(Path(os.getcwd()))

    # Get commit SHA from stacked git
    if branch:
        click.echo(f"Getting commit SHA for patch {patch_name} from branch {branch}...")
    else:
        click.echo(f"Getting commit SHA for patch {patch_name}...")

    commit_sha = git.get_stg_patch_sha(patch_name, branch)
    click.echo(f"Found commit SHA: {commit_sha}")

    # Reuse push-sha logic
    git.ensure_clean()

    # Create new branch name '${USER_NAME}/${patch-name}'
    new_branch_name = f"{USER_NAME}/{patch_name}"

    current_branch_info = git.get_branch_info("HEAD")

    click.echo(f"Validating commit SHA... {commit_sha}")
    git.validate_commit_exists(commit_sha)

    click.echo(f"Creating new branch from HEAD... {new_branch_name}")
    git.make_new_branch(new_branch_name, 'HEAD', force=force)

    click.echo(f"Setting upstream for {new_branch_name} to {current_branch_info.name}")
    git.set_branch_upstream(new_branch_name, current_branch_info.name)

    click.echo(f"Switching to branch... {new_branch_name}")
    git.switch_to_branch(new_branch_name)

    click.echo(f"Merging commit {commit_sha}...")
    git.merge_commit_with_soft_conflicts(commit_sha)


@main.command()
@click.option("--onto", type=str, default=None, help="Upstream for the first patch branch (defaults to current branch)")
@click.option("--branch", "-b", type=str, default=None, help="Stacked git branch to get patches from")
def stg_stack(onto: str, branch: str):
    """Create git branches from currently applied stacked git patches with proper upstream relationships."""
    git = GitOps.new_from_dir(Path(os.getcwd()))

    git.ensure_clean()

    # Get currently applied patches from stacked git
    if branch:
        click.echo(f"Getting applied patches from stacked git branch: {branch}")
    else:
        click.echo("Getting applied patches from current stacked git branch")

    applied_patches = git.get_stg_applied_patches(branch)

    if not applied_patches:
        click.echo("No applied patches found in stacked git")
        return

    click.echo(f"Found {len(applied_patches)} applied patch(es): {', '.join(applied_patches)}")

    # Determine root upstream
    if onto:
        root_upstream = onto
        click.echo(f"Using specified upstream: {root_upstream}")
    else:
        root_upstream = git._run_output(["git", "rev-parse", "--abbrev-ref", "HEAD"])
        click.echo(f"Using current branch as upstream: {root_upstream}")

    # Create branches from patches
    previous_branch = root_upstream
    created_branches = []

    for patch_name in applied_patches:
        # Create branch name '${USER_NAME}/${patch-name}'
        new_branch_name = f"{USER_NAME}/{patch_name}"

        # Get commit SHA from stacked git
        commit_sha = git.get_stg_patch_sha(patch_name, branch)

        click.echo(f"\nProcessing patch: {patch_name}")
        click.echo(f"  Commit SHA: {commit_sha}")
        click.echo(f"  Branch name: {new_branch_name}")
        click.echo(f"  Creating branch from {commit_sha}...")

        # Force create branch from the patch commit
        git.make_new_branch(new_branch_name, commit_sha, force=True)

        # Set upstream to previous branch
        click.echo(f"  Setting upstream to: {previous_branch}")
        git.set_branch_upstream(new_branch_name, previous_branch)

        created_branches.append(new_branch_name)
        previous_branch = new_branch_name

    click.echo(f"\n✓ Successfully created {len(created_branches)} branch(es) from stacked git patches")
    click.echo("\nBranch chain:")
    chain = [root_upstream] + created_branches
    click.echo(f"  {' -> '.join(chain)}")


@main.command()
@click.argument("branch_target", type=str)
@click.option("-n", "--num", type=int, default=None, help="Number of branches to convert (defaults to all local branches)")
@click.option("--until", type=str, default=None, help="Stop at this branch (inclusive)")
@click.option("--dry-run", is_flag=True, default=False, help="Show what would be done without making changes")
def stg_unstack(branch_target: str, num: int, until: str, dry_run: bool):
    """Convert git branch commits into stacked git patches."""
    git = GitOps.new_from_dir(Path(os.getcwd()))

    if not dry_run:
        git.ensure_clean()

    # Check if branch already exists and has stg patches
    stack_info = git.get_stg_stack_info(branch_target)

    if stack_info['has_patches']:
        click.echo(f"⚠ Branch '{branch_target}' already exists with stacked git patches")
        click.echo(f"  Applied patches ({len(stack_info['applied'])}): {', '.join(stack_info['applied']) if stack_info['applied'] else '(none)'}")
        click.echo(f"  Unapplied patches ({len(stack_info['unapplied'])}): {', '.join(stack_info['unapplied']) if stack_info['unapplied'] else '(none)'}")
        click.echo(f"  Hidden patches ({len(stack_info['hidden'])}): {', '.join(stack_info['hidden']) if stack_info['hidden'] else '(none)'}")

        if dry_run:
            click.echo("[DRY RUN] Would ask for confirmation to clean up stacked git patches and continue")
        else:
            if not click.confirm(f"\nDo you want to clean up stacked git patches on '{branch_target}' and continue?", default=False):
                click.echo("Aborted.")
                return

            # Clean up the stg stack
            click.echo(f"Cleaning up stacked git patches on '{branch_target}'...")
            git.cleanup_stg_stack(branch_target)
            click.echo("✓ Cleanup complete")

        click.echo("")
    elif git.branch_exists(branch_target):
        # Branch exists but no patches - will be force created later
        click.echo(f"⚠ Branch '{branch_target}' already exists (will be overwritten)")
        click.echo("")

    if dry_run:
        click.echo("[DRY RUN MODE - No changes will be made]\n")

    # Validate conflicting options
    if num is not None and until is not None:
        raise click.ClickException("Cannot specify both -n/--num and --until")

    # If until is specified, get branches where until is the upstream limit (exclusive)
    if until is not None:
        click.echo(f"Getting branches with upstream after: {until}")
        try:
            current_branch = git._run_output(["git", "rev-parse", "--abbrev-ref", "HEAD"])
            origin_ref, local_branches = git.get_parent_branches(current_branch)

            # Add current branch to the list
            all_branches = local_branches + [current_branch]

            # Find branches that have 'until' as an ancestor but don't include 'until' itself
            # We want all branches downstream of 'until'
            branches = []
            for branch in all_branches:
                # Check if this branch has 'until' as its upstream (directly or indirectly)
                try:
                    branch_upstream = git._run_output(["git", "rev-parse", "--abbrev-ref", f"{branch}@{{upstream}}"])
                    # If the branch's upstream is 'until', include this branch
                    if branch_upstream == until:
                        branches.append(branch)
                        # Continue to get all branches downstream
                    elif until in all_branches and all_branches.index(branch) > all_branches.index(until):
                        branches.append(branch)
                except sp.CalledProcessError:
                    # No upstream, skip
                    pass

            if not branches:
                raise click.ClickException(f"No branches found with upstream '{until}'")

            num = len(branches)
            upstream_of_oldest = until

            click.echo(f"Found {num} branch(es) downstream of '{until}'")
        except RuntimeError as e:
            raise click.ClickException(str(e))
    # If num is not specified, get all local branches
    elif num is None:
        click.echo("Getting all local branches from current commit...")
        try:
            current_branch = git._run_output(["git", "rev-parse", "--abbrev-ref", "HEAD"])
            origin_ref, local_branches = git.get_parent_branches(current_branch)

            if not local_branches:
                raise click.ClickException("No local parent branches found")

            # Add current branch to the list
            branches = local_branches + [current_branch]
            num = len(branches)
            upstream_of_oldest = origin_ref if origin_ref else local_branches[0] if local_branches else None

            if upstream_of_oldest is None:
                raise click.ClickException("Could not determine upstream for the oldest branch")

            click.echo(f"Found {num} local branch(es)")
        except RuntimeError as e:
            raise click.ClickException(str(e))
    else:
        click.echo(f"Getting branch chain ({num} levels deep) from current commit...")
        try:
            branches, upstream_of_oldest = git.get_branch_chain_from_current(num)
        except RuntimeError as e:
            raise click.ClickException(str(e))

    click.echo(f"Found branches: {' -> '.join(branches)}")
    click.echo(f"Upstream of oldest branch: {upstream_of_oldest}")

    # Filter branches with commits (skip those with 0 commits)
    click.echo("\nFiltering branches with commits...")
    try:
        branches_with_commits, skipped_branches = git.filter_branches_with_commits(branches)

        if skipped_branches:
            click.echo(f"Skipping {len(skipped_branches)} branch(es) with 0 commits: {', '.join(skipped_branches)}")

        if not branches_with_commits:
            raise click.ClickException("No branches with commits found")

        click.echo(f"✓ Found {len(branches_with_commits)} branch(es) with exactly 1 commit each")
        branches = branches_with_commits
        num = len(branches)
    except RuntimeError as e:
        raise click.ClickException(str(e))

    # Strip USERNAME/ prefix from branch names for patch names
    username_prefix = f"{USER_NAME}/"
    patch_names = []
    for branch_name in branches:
        if branch_name.startswith(username_prefix):
            patch_names.append(branch_name[len(username_prefix):])
        else:
            patch_names.append(branch_name)
    patch_names_r = list(reversed(patch_names))

    click.echo(f"\nPatch names (after stripping '{username_prefix}' prefix): {' '.join(patch_names)}")

    if dry_run:
        click.echo(f"\n[DRY RUN] Would create new stacked git branch: {branch_target}")
        click.echo(f"[DRY RUN] Would switch to: {branch_target}")
        click.echo(f"[DRY RUN] Would uncommit {num} commits as patches: {' '.join(patch_names)}")
        click.echo(f"[DRY RUN] Would set upstream to: {upstream_of_oldest}")
        click.echo(f"\n[DRY RUN] Summary:")
        click.echo(f"  Branch: {branch_target}")
        click.echo(f"  Patches: {', '.join(patch_names)}")
        click.echo(f"  Upstream: {upstream_of_oldest}")
        return

    # Force create new branch from current HEAD
    click.echo(f"\nCreating new stacked git branch: {branch_target}")
    git.make_new_branch(branch_target, 'HEAD', force=True)

    # Switch to new branch
    click.echo(f"Switching to: {branch_target}")
    git.switch_to_branch(branch_target)

    # Run stg uncommit with patch names (with username prefix stripped)
    click.echo(f"\nUncommitting {num} commits as patches...")
    click.echo(f"Patch names: {' '.join(patch_names)}")

    stg_cmd = ["stg", "uncommit"] + patch_names_r
    git._trace_cmd(stg_cmd)
    try:
        sp.run(stg_cmd, check=True)
    except sp.CalledProcessError as e:
        raise click.ClickException(f"Failed to uncommit patches: {e}")

    # Set upstream to upstream of oldest branch
    click.echo(f"\nSetting upstream to: {upstream_of_oldest}")
    git.set_branch_upstream(branch_target, upstream_of_oldest)

    click.echo(f"\n✓ Successfully created stacked git branch: {branch_target}")
    click.echo(f"  Patches created: {', '.join(patch_names)}")
    click.echo(f"  Upstream: {upstream_of_oldest}")


@main.command()
@click.option("--full", is_flag=True, default=False, help="Also rebase the root branch")
@click.option("--branch", "-b", type=str, default=None, help="Branch to restack (defaults to current branch)")
def restack_branch(full: bool, branch: str):
    """Restack a branch by rebasing all parent branches in the chain."""
    git = GitOps.new_from_dir(Path(os.getcwd()))

    git.ensure_clean()

    # Determine which branch to restack and switch to it if specified
    if branch is None:
        target_branch = git._run_output(["git", "rev-parse", "--abbrev-ref", "HEAD"])
        click.echo(f"Restacking current branch: {target_branch}")
    else:
        target_branch = branch
        click.echo(f"Switching to branch: {target_branch}")
        git.switch_to_branch(target_branch)
        click.echo(f"Restacking branch: {target_branch}")

    # Find all parent branches
    origin_ref, local_branches = git.get_parent_branches(target_branch)

    if not local_branches:
        click.echo("No parent branches found. Nothing to restack.")
        return

    # Build full chain for display: origin_ref -> local_branches
    local_branches_full = local_branches + [target_branch]
    if origin_ref:
        full_chain = [origin_ref] + local_branches_full
        click.echo(f"Found {len(local_branches)} local parent branch(es): {' -> '.join(full_chain)}")
    else:
        click.echo(f"Found {len(local_branches)} local parent branch(es): {' -> '.join(local_branches)}")

    # Determine which branches to rebase
    if full and origin_ref:
        # Include the first local branch (downstream of origin_ref) when --full is used
        branches_to_rebase = local_branches_full
        click.echo("Running git pull -r on all parent branches (including root)")
    elif full and not origin_ref:
        # No origin ref, so rebase all local branches
        branches_to_rebase = local_branches_full
        click.echo("Running git pull -r on all parent branches")
    else:
        # Exclude the first local branch (the one directly downstream of origin_ref or root)
        branches_to_rebase = local_branches_full[1:]
        if not branches_to_rebase:
            click.echo("Only root branch found. Use --full to rebase it.")
            return
        click.echo(f"Running git pull -r on {len(branches_to_rebase)} parent branch(es) (excluding root)")

    # Save current branch
    original_branch = git._run_output(["git", "rev-parse", "--abbrev-ref", "HEAD"])

    # Rebase each parent branch
    for parent in branches_to_rebase:
        click.echo(f"\n{'='*60}")
        click.echo(f"Restacking: {parent}")
        click.echo(f"{'='*60}")

        git.switch_to_branch(parent)
        git.rebase_pull()

    # Return to original branch
    click.echo(f"\n{'='*60}")
    click.echo(f"Returning to: {original_branch}")
    click.echo(f"{'='*60}")
    git.switch_to_branch(original_branch)

    click.echo(f"\n✓ Successfully restacked all parent branches")


