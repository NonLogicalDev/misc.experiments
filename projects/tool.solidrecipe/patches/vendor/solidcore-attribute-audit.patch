 use core::any::Any;
 use std::collections::BTreeMap;
 
+thread_local! {
+    // The kernel session runs synchronously on its caller's thread. If that
+    // changes, this audit must travel with work dispatched to other threads.
+    static APPLICATION_FAILURE: std::cell::Cell<Option<bool>> = const { std::cell::Cell::new(None) };
+}
+
+/// Run one synchronous operation and report application-handler failures.
+///
+/// The flag records handler and placement errors returned by `run_application`,
+/// even when a caller later ignores their status. It does not detect other
+/// attribute-store errors or notifications never emitted.
+/// A nested audit is refused and makes the outer audit incomplete. Scope state
+/// is reset on return or panic, and never shared between threads.
+pub fn with_application_failure_audit<T>(f: impl FnOnce() -> T) -> Option<(T, bool)> {
+    let entered = APPLICATION_FAILURE.with(|state| {
+        if state.get().is_some() {
+            state.set(Some(true));
+            false
+        } else {
+            state.set(Some(false));
+            true
+        }
+    });
+    if !entered {
+        return None;
+    }
+    struct Reset;
+    impl Drop for Reset {
+        fn drop(&mut self) {
+            APPLICATION_FAILURE.with(|state| state.set(None));
+        }
+    }
+    let guard = Reset;
+    let output = f();
+    let failed = APPLICATION_FAILURE.with(|state| state.get().unwrap_or(true));
+    drop(guard);
+    Some((output, failed))
+}
+
+fn note_application_failure() {
+    APPLICATION_FAILURE.with(|state| {
+        if state.get().is_some() {
+            state.set(Some(true));
+        }
+    });
+}
