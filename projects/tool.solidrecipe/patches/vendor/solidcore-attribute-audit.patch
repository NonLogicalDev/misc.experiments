 /// The lowest [`Provenance::ID`] an application may take.
 pub const FIRST_ID: u64 = ids::USER_1;
+
+/// Audit application-handler failures during one synchronous operation.
+///
+/// The flag reports handler and placement errors returned by the attribute
+/// store's `run_application`, including errors a geometry operation later ignores.
+/// It does not detect other store errors or prove all notifications were emitted.
+/// Callers must reject incomplete provenance when the flag is set.
+/// A nested audit returns [`crate::Error::Reentered`] and flags the outer audit.
+pub fn with_failure_audit<T>(f: impl FnOnce() -> T) -> crate::Result<(T, bool)> {
+    solidcore::geom::attribute::with_application_failure_audit(f).ok_or(crate::Error::Reentered)
+}
 
 /// `P::ID` is an application's, checked when the code using `P` is compiled.
 struct ApplicationId<P>(std::marker::PhantomData<P>);
