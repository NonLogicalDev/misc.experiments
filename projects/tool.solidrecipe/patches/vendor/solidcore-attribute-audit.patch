+#[cfg(test)]
+mod audit_tests {
+    use super::with_failure_audit;
+    use crate::{blend_ordered, boolean::boolean, make_box, Blend, Body, BooleanOp, Corners};
+    use solidcore::geom::attribute::{
+        Attribute, AttributeHandlers, AttributeView, Behavior, ObjectKey, Placement,
+    };
+    use solidcore::EntityRef;
+    use std::sync::{
+        atomic::{AtomicUsize, Ordering},
+        Arc,
+    };
+
+    #[derive(Clone, Debug)]
+    struct RefuseSplit(Arc<AtomicUsize>);
+    impl PartialEq for RefuseSplit {
+        fn eq(&self, other: &Self) -> bool {
+            Arc::ptr_eq(&self.0, &other.0)
+        }
+    }
+    impl AttributeHandlers for RefuseSplit {
+        fn split(
+            &self,
+            _: &AttributeView<'_>,
+            _: ObjectKey,
+            _: ObjectKey,
+            _: ObjectKey,
+        ) -> solidcore::Result<Vec<Placement>> {
+            self.0.fetch_add(1, Ordering::Relaxed);
+            Err(solidcore::SolidError::sm_err(
+                "injected attribute notification failure",
+            ))
+        }
+    }
+
+    /// Attach a test-only failing attribute to the exact operation body's handles.
+    fn inject(body: &Body, counter: &Arc<AtomicUsize>) {
+        let (_, order) = body.to_record().unwrap();
+        crate::session::with_body("inject audit test", body, |_, b| {
+            for f in &order.faces {
+                b.add_attribute(
+                    EntityRef::Face(*f),
+                    Attribute::application(
+                        super::FIRST_ID + 81,
+                        Behavior::Copy,
+                        RefuseSplit(Arc::clone(counter)),
+                    ),
+                )?;
+            }
+            for e in &order.edges {
+                b.add_attribute(
+                    EntityRef::Edge(*e),
+                    Attribute::application(
+                        super::FIRST_ID + 81,
+                        Behavior::Copy,
+                        RefuseSplit(Arc::clone(counter)),
+                    ),
+                )?;
+            }
+            Ok(())
+        })
+        .unwrap();
+    }
+
+    #[test]
+    fn boolean_reports_suppressed_attribute_failure() {
+        let a = make_box([0., 0., 0.], [3., 3., 3.]).unwrap();
+        let b = make_box([-1., -1., 1.], [5., 5., 1.]).unwrap();
+        let counter = Arc::new(AtomicUsize::new(0));
+        inject(&a, &counter);
+        inject(&b, &counter);
+        let (result, failed) = with_failure_audit(|| boolean(a, b, BooleanOp::Subtract)).unwrap();
+        assert!(
+            result.unwrap().is_some(),
+            "geometry must reach successful completion"
+        );
+        assert!(
+            counter.load(Ordering::Relaxed) > 0,
+            "the operation must reach the failing handler"
+        );
+        assert!(
+            failed,
+            "an ignored callback failure must invalidate history"
+        );
+        assert!(
+            !with_failure_audit(|| ()).unwrap().1,
+            "the scope must reset"
+        );
+    }
+
+    #[test]
+    fn blends_report_suppressed_attribute_failure() {
+        for kind in [Blend::Round, Blend::Chamfer] {
+            let b = make_box([0., 0., 0.], [10., 10., 10.]).unwrap();
+            let counter = Arc::new(AtomicUsize::new(0));
+            inject(&b, &counter);
+            let (_, order) = b.to_record().unwrap();
+            let (result, failed) = with_failure_audit(|| {
+                blend_ordered(
+                    &b,
+                    &order,
+                    kind,
+                    &[0],
+                    &[0.5],
+                    &[],
+                    Corners::Filled,
+                    Default::default(),
+                )
+            })
+            .unwrap();
+            result.unwrap();
+            assert!(
+                counter.load(Ordering::Relaxed) > 0,
+                "the operation must reach the failing handler"
+            );
+            assert!(
+                failed,
+                "an ignored callback failure must invalidate history"
+            );
+        }
+    }
