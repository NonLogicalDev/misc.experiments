+    fn legacy_slit_cleanup_marks_audit_only_on_edit_or_error() {
+        use crate::boolean::api_brep::boolean_union;
+        use crate::geom::attribute::with_application_failure_audit;
+        use crate::math::Point3;
+        use crate::primitive::api_primitives::{create_box, create_cylinder};
+        let mut kernel = crate::kernel::Kernel::default();
+        let cube = create_box(&mut kernel, Point3::new(0., 0., 0.), 10., 10., 10.).unwrap();
+        let post = create_cylinder(&mut kernel, Point3::new(12.5, 5., 2.), 2.5, 6.).unwrap();
+        super::TEST_LEGACY_SLIT_CLEANUP.with(|flag| flag.set(true));
+        let (result, failed) =
+            with_application_failure_audit(|| boolean_union(&mut kernel, cube, post)).unwrap();
+        super::TEST_LEGACY_SLIT_CLEANUP.with(|flag| flag.set(false));
+        assert!(result.is_ok());
+        assert!(
+            failed,
+            "the actual touching union removed a slit without merge identities"
+        );
+        let (result, failed) =
+            with_application_failure_audit(|| super::record_legacy_slit_result(Ok(false))).unwrap();
+        assert_eq!(result.unwrap(), false);
+        assert!(!failed, "a no-op must keep the audit clean");
+        let (result, failed) = with_application_failure_audit(|| {
+            super::record_legacy_slit_result(Err(crate::SolidError::invalid_input(
+                "test", "injected",
+            )))
+        })
+        .unwrap();
+        assert!(result.is_err());
+        assert!(
+            failed,
+            "a possibly partial cleanup error must fail the audit"
+        );
+    }
