+/// Legacy slit cleanup for adapters without merge-owned notification identities.
+/// If cleanup edits topology or fails, any active application provenance audit
+/// is marked incomplete. Without an audit this retains the legacy behavior.
+///
+/// # Errors
+/// Those of slit-loop cleanup.
+fn remove_touch_slit_loops_with_local_notifications(
+    kernel: &mut Kernel,
+    primary: &mut Brep,
+    attributes: &mut AttributeStore,
+) -> Result<bool> {
+    let mut records = crate::topology::topology::NotifyRecords::new();
+    let mut env = edge::NotifyEnv {
+        records: &mut records,
+        attributes,
+        context: None,
+        key_of: &crate::topology::loopuse::notify_ref,
+    };
+    let result =
+        crate::topology::brep::p3::remove_slit_loops_where_solids_touch(kernel, primary, &mut env);
+    record_legacy_slit_result(result)
+}
+
+fn record_legacy_slit_result(result: Result<bool>) -> Result<bool> {
+    if !matches!(result, Ok(false)) {
+        crate::geom::attribute::note_application_failure();
+    }
+    result
+}
+
+#[cfg(test)]
+thread_local! {
+    static TEST_LEGACY_SLIT_CLEANUP: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
