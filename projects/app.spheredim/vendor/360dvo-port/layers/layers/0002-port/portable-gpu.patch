@@ -0,0 +1,24 @@
+"""Grouped reductions used by inference, without torch-scatter extensions."""
+import torch
+
+
+def scatter_sum(src, index, dim=1, dim_size=None):
+    if dim != 1 or index.ndim != 1:
+        raise ValueError('Expected one-dimensional indices along dimension 1')
+    size = int(index.max().item()) + 1 if dim_size is None and index.numel() else (dim_size or 0)
+    result = src.new_zeros((src.shape[0], size, *src.shape[2:]))
+    return result.index_add(1, index, src)
+
+
+def scatter_softmax(src, index, dim=1):
+    if dim != 1 or index.ndim != 1:
+        raise ValueError('Expected one-dimensional indices along dimension 1')
+    if not index.numel():
+        return src
+    groups = int(index.max().item()) + 1
+    expanded = index.reshape(1, -1, *([1] * (src.ndim - 2))).expand_as(src)
+    shape = (src.shape[0], groups, *src.shape[2:])
+    maximum = src.new_full(shape, -torch.inf).scatter_reduce_(1, expanded, src, reduce='amax', include_self=True)
+    weights = (src - maximum.gather(1, expanded)).exp()
+    totals = src.new_zeros(shape).scatter_add_(1, expanded, weights)
+    return weights / totals.gather(1, expanded)
