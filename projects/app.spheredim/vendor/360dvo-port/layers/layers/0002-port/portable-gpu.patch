@@ -0,0 +1,100 @@
+"""Run 360DVO on full equirectangular video using CPU, Apple MPS, or ROCm."""
+import argparse
+import csv
+import json
+import math
+from pathlib import Path
+
+import cv2
+import numpy as np
+from scipy.spatial.transform import Rotation
+import torch
+
+from dpvo.config import cfg
+from dpvo.dpvo import DPVO
+
+
+def choose_device(requested):
+    if requested != 'auto':
+        device = torch.device(requested)
+        if device.type == 'mps' and not torch.backends.mps.is_available():
+            raise RuntimeError('Apple MPS is unavailable')
+        if device.type == 'cuda' and not torch.cuda.is_available():
+            raise RuntimeError('PyTorch GPU backend is unavailable')
+        return device
+    if torch.backends.mps.is_available():
+        return torch.device('mps')
+    if torch.cuda.is_available():  # ROCm also exposes its device through this API.
+        return torch.device('cuda')
+    return torch.device('cpu')
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('video', type=Path)
+    parser.add_argument('output', type=Path)
+    parser.add_argument('--weights', type=Path, required=True)
+    parser.add_argument('--device', choices=('auto', 'cpu', 'mps', 'cuda'), default='auto')
+    parser.add_argument('--width', type=int, default=512)
+    parser.add_argument('--patches', type=int, default=48)
+    parser.add_argument('--stride', type=int, default=1)
+    args = parser.parse_args()
+    if args.width < 128 or args.width % 32:
+        parser.error('width must be a multiple of 32 and at least 128')
+    if args.patches < 1 or args.stride < 1:
+        parser.error('patches and stride must be positive')
+    if not args.video.is_file() or not args.weights.is_file():
+        parser.error('input video and model weights must exist')
+    if args.output.exists() and any(args.output.iterdir()):
+        parser.error('output must be an empty directory')
+    device = choose_device(args.device)
+    capture = cv2.VideoCapture(str(args.video))
+    width = int(capture.get(cv2.CAP_PROP_FRAME_WIDTH))
+    height = int(capture.get(cv2.CAP_PROP_FRAME_HEIGHT))
+    fps = capture.get(cv2.CAP_PROP_FPS)
+    if not capture.isOpened() or width != 2 * height or not math.isfinite(fps) or fps <= 0:
+        raise RuntimeError('Expected a readable 2:1 equirectangular video with known frame rate')
+    cfg.merge_from_file(str(Path(__file__).parent / 'config/360.yaml'))
+    cfg.MIXED_PRECISION = False
+    cfg.PATCHES_PER_FRAME = args.patches
+    cfg.BUFFER_SIZE = 512
+    tracker = DPVO(cfg, str(args.weights), ht=args.width // 2, wd=args.width, device=device)
+    intrinsics = torch.tensor([args.width/(2*math.pi), -args.width/(2*math.pi), args.width/2, args.width/4], dtype=torch.float32, device=device)
+    source_index = 0
+    used = 0
+    torch.manual_seed(0)
+    with torch.no_grad():
+        while True:
+            ok, frame = capture.read()
+            if not ok:
+                break
+            if source_index % args.stride == 0:
+                frame = cv2.resize(frame, (args.width, args.width // 2), interpolation=cv2.INTER_AREA)
+                image = torch.from_numpy(frame).permute(2, 0, 1).to(device)
+                tracker(source_index / fps, image, intrinsics)
+                used += 1
+                print(f'Processed frame {used}', flush=True)
+            source_index += 1
+        if not tracker.is_initialized:
+            raise RuntimeError('360DVO did not initialize; more motion or texture may be needed')
+        for _ in range(12):
+            tracker.update()
+        poses, timestamps = tracker.terminate()
+    capture.release()
+    rows = []
+    for i, (pose, time) in enumerate(zip(poses, timestamps)):
+        transform = np.column_stack((Rotation.from_quat(pose[3:7]).as_matrix(), pose[:3]))
+        rows.append({'frame': i, 'time_seconds': float(time), 'image': f'{i:06}', 'world_from_camera': transform.tolist()})
+    args.output.mkdir(parents=True, exist_ok=True)
+    data = {'schema':'spheredim-poses-v1','input_video':str(args.video.resolve()),'sampling_fps':fps/args.stride,'camera_model':'360DVO equirectangular','coordinates':'camera-to-world 3x4 row-major; camera x right, y down, z forward; arbitrary world axes and scale','registered':len(rows),'sampled':len(rows),'frames':rows,'note':'360DVO reconstructs poses for removed frames from relative motion; these are not independent direct observations.'}
+    (args.output/'poses.json').write_text(json.dumps(data,indent=2)+'\n')
+    with (args.output/'poses.csv').open('w',newline='') as f:
+        writer=csv.writer(f)
+        writer.writerow(['frame','time_seconds','image','registered']+[f'm{r}{c}' for r in range(3) for c in range(4)])
+        for row in rows:
+            writer.writerow([row['frame'],row['time_seconds'],row['image'],1]+[v for line in row['world_from_camera'] for v in line])
+    print(f'Wrote {len(rows)} poses to {args.output} using {device}')
+
+
+if __name__ == '__main__':
+    main()
