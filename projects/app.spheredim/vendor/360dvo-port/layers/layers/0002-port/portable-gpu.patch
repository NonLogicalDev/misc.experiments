+"""Numerical reference tests for portable GPU tracking operations."""
+import os
+import unittest
+import torch
+
+from dpvo.altcorr import corr, patchify
+from dpvo.fastba import BA, neighbors
+from dpvo.lietorch import SE3
+from dpvo.portable_scatter import scatter_softmax, scatter_sum
+from dpvo import projective_ops
+
+DEVICE = os.environ.get('SPHEREDIM_DEVICE', 'cpu')
+
+
+def bilinear(image, x, y):
+    h, w = image.shape
+    x0, y0 = int(torch.floor(x)), int(torch.floor(y))
+    value = 0.0
+    for dy in (0, 1):
+        for dx in (0, 1):
+            px, py = x0 + dx, y0 + dy
+            if 0 <= px < w and 0 <= py < h:
+                value += image[py, px].item() * (1 - abs(x.item()-px)) * (1 - abs(y.item()-py))
+    return value
+
+
+class PortableOperators(unittest.TestCase):
+    def test_patchify_interpolates_and_zero_pads(self):
+        image = torch.arange(20., device=DEVICE).reshape(1,1,4,5)
+        points = torch.tensor([[[2.25,1.5],[0.2,0.1]]], device=DEVICE)
+        actual = patchify(image, points, 1).cpu()
+        expected = torch.empty_like(actual)
+        for i in range(2):
+            for y in range(3):
+                for x in range(3):
+                    expected[0,i,0,y,x] = bilinear(image.cpu()[0,0],points.cpu()[0,i,0]+x-1,points.cpu()[0,i,1]+y-1)
+        torch.testing.assert_close(actual, expected, atol=1e-5, rtol=1e-5)
+
+    def test_correlation_matches_scalar_reference(self):
+        torch.manual_seed(7)
+        source = torch.randn(1, 2, 4, 2, 2).to(DEVICE)
+        target = torch.randn(1, 2, 4, 4, 5).to(DEVICE)
+        points = (torch.rand(1, 3, 2, 2, 2)*4 - .5).to(DEVICE)
+        ii = torch.tensor([0,1,0],device=DEVICE)
+        jj = torch.tensor([1,0,1],device=DEVICE)
+        actual = corr(source,target,points,ii,jj,1).cpu()
+        s,t,p = source.cpu(),target.cpu(),points.cpu()
+        expected = torch.zeros_like(actual)
+        for e in range(3):
+            for ox in range(3):
+                for oy in range(3):
+                    for y in range(2):
+                        for x in range(2):
+                            for c in range(4):
+                                expected[0,e,ox,oy,y,x] += s[0,ii[e],c,y,x]*bilinear(t[0,jj[e],c],p[0,e,0,y,x]+ox-1,p[0,e,1,y,x]+oy-1)
+        torch.testing.assert_close(actual,expected,atol=1e-5,rtol=1e-5)
+
+    def test_neighbors_and_group_reductions(self):
+        ii = torch.tensor([1,0,1,1,0],device=DEVICE); jj = torch.tensor([4,3,2,4,1],device=DEVICE)
+        before, after = neighbors(ii,jj)
+        self.assertEqual(before.cpu().tolist(), [2,4,-1,0,-1])
+        self.assertEqual(after.cpu().tolist(), [3,-1,0,-1,1])
+        values = torch.tensor([[[1.,2.],[3.,1.],[4.,3.],[2.,4.],[3.,2.]]],device=DEVICE)
+        weights = scatter_softmax(values,ii)
+        for g in (0,1):
+            mask = ii == g
+            torch.testing.assert_close(weights[:,mask].cpu(),torch.softmax(values[:,mask],dim=1).cpu())
+        sums = scatter_sum(values,ii,dim_size=2)
+        torch.testing.assert_close(sums[:,0].cpu(),values[:,ii==0].sum(dim=1).cpu())
+
+    def test_spherical_pose_jacobians(self):
+        dtype = torch.float32 if DEVICE != 'cpu' else torch.float64
+        twists = torch.tensor([[[.1,.2,.3,.01,.02,.03],[.3,-.1,.2,.03,-.02,.04]]],dtype=dtype,device=DEVICE)
+        poses = SE3.exp(twists)
+        patches = torch.zeros(1,1,3,3,3,dtype=dtype,device=DEVICE)
+        patches[:,:,0]=170;patches[:,:,1]=80;patches[:,:,2]=.5
+        intrinsics = torch.tensor([[[100.,-100.,160.,80.],[100.,-100.,160.,80.]]],dtype=dtype,device=DEVICE)
+        ii=torch.tensor([0],device=DEVICE);jj=torch.tensor([1],device=DEVICE);kk=torch.tensor([0],device=DEVICE)
+        _,_,(ji,jjaco,jd)=projective_ops.transform(poses,patches,intrinsics,ii,jj,kk,jacobian=True)
+        eps = 1e-3 if dtype == torch.float32 else 1e-6
+        for which,jac in ((0,ji),(1,jjaco)):
+            columns=[]
+            for k in range(6):
+                delta=torch.zeros(1,2,6,dtype=dtype,device=DEVICE);delta[0,which,k]=eps
+                plus=projective_ops.transform(poses.retr(delta),patches,intrinsics,ii,jj,kk)[0,0,1,1]
+                delta[0,which,k]=-eps
