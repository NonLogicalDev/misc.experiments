+        torch.testing.assert_close(numerical[0,0,1,1].cpu(),jd[0,0,:,0].cpu(),atol=.025 if dtype == torch.float32 else 1e-5,rtol=1e-3)
+
+    def test_depth_reset_and_unobserved_patch(self):
