+"""Inference SE(3) operations implemented using portable PyPose tensors."""
+import torch
+import pypose as pp
+
+
+class SE3:
+    def __init__(self, data):
+        self.data = data
+
+    @classmethod
+    def Identity(cls, *shape, device=None, dtype=None):
+        if len(shape) == 1 and isinstance(shape[0], (tuple, list, torch.Size)):
+            shape = tuple(shape[0])
+        value = torch.zeros(*shape, 7, device=device, dtype=dtype or torch.float32)
+        value[..., 6] = 1
+        return cls(value)
+
+    @classmethod
+    def exp(cls, tangent):
+        return cls(pp.se3(tangent).Exp().tensor())
+
+    @property
+    def device(self):
+        return self.data.device
+
+    @property
+    def shape(self):
+        return self.data.shape[:-1]
+
+    def inv(self):
+        return SE3(pp.SE3(self.data).Inv().tensor())
+
+    def log(self):
+        return pp.SE3(self.data).Log().tensor()
+
+    def retr(self, tangent):
+        return SE3.exp(tangent) * self
+
+    def adjT(self, vector):
+        # Upstream expects a row Jacobian multiplied by the SE(3) adjoint.
+        matrix = self.matrix()
+        rotation = matrix[..., :3, :3]
+        x, y, z = self.data[..., :3].unbind(-1)
+        zero = torch.zeros_like(x)
+        cross = torch.stack((zero, -z, y, z, zero, -x, -y, x, zero), dim=-1).reshape(*x.shape, 3, 3)
+        top = torch.cat((rotation, cross @ rotation), dim=-1)
+        bottom = torch.cat((torch.zeros_like(rotation), rotation), dim=-1)
+        adjoint = torch.cat((top, bottom), dim=-2)
+        return torch.matmul(vector.unsqueeze(-2), adjoint).squeeze(-2)
+
+    def matrix(self):
+        return pp.SE3(self.data).matrix()
+
+    def __mul__(self, other):
+        if isinstance(other, SE3):
+            return SE3((pp.SE3(self.data) @ pp.SE3(other.data)).tensor())
+        return pp.SE3(self.data).Act(other)
+
+    def __getitem__(self, key):
+        return SE3(self.data[key])
+
+    def __setitem__(self, key, value):
+        self.data[key] = value.data if isinstance(value, SE3) else value
+
+
+def stack(groups, dim=0):
+    return SE3(torch.stack([g.data for g in groups], dim=dim))
