+
+    def test_bad_hessian_and_mismatched_intrinsics_fail(self):
+        from dpvo.ba import CholeskySolver
+        with self.assertRaisesRegex(RuntimeError, 'positive definite'):
+            CholeskySolver.apply(-torch.eye(2, device=DEVICE)[None], torch.ones(1, 2, 1, device=DEVICE))
