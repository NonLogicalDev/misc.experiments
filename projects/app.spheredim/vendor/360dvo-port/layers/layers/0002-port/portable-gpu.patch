+def neighbors(ii, jj):
+    # Stable sorting reproduces the upstream ordering of edges with equal targets.
+    order = torch.argsort(jj, stable=True)
+    order = order[torch.argsort(ii[order], stable=True)]
+    groups = ii[order]
+    same = groups[1:] == groups[:-1]
+    before = torch.full_like(ii, -1)
