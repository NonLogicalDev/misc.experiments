+
+    def test_bundle_adjustment_reduces_error_and_keeps_anchor(self):
+        n=20; pose=SE3.Identity(1,2,device=DEVICE).data
+        patches=torch.zeros(1,n,3,3,3,device=DEVICE)
+        patches[:,:,0]=torch.linspace(100,200,n,device=DEVICE)[:,None,None];patches[:,:,1]=torch.linspace(50,100,n,device=DEVICE)[:,None,None];patches[:,:,2]=1
