+
+// Pick the single periodic copy that minimizes the positive-definite conic.
+[ForceInline]
+float erp_conic_dx(float dx, float dy, float3 conic, float width) {
+    if (conic.x <= 0.0f) return dx;
+    float shift = conic.y * dy / conic.x;
+    return dx - width * floor((dx + shift) / width + 0.5f);
+}
