diff --git a/src/kernels/raster/PeriodicConic.cuh b/src/kernels/raster/PeriodicConic.cuh
new file mode 100644
index 0000000..f5c224f
--- /dev/null
+++ b/src/kernels/raster/PeriodicConic.cuh
@@ -0,0 +1,12 @@
+#pragma once
+
+// Choose one horizontal copy that minimizes the conic at this pixel. The
+// integer copy is locally constant, so existing derivatives apply off ties.
+__device__ __forceinline__ float erp_conic_pixel_x(
+    float px, float py, float2 mean, float3 conic, float width
+) {
+    if (conic.x <= 0.f) return px;
+    float dx = mean.x - px, dy = mean.y - py;
+    float copies = floorf((dx + conic.y * dy / conic.x) / width + 0.5f);
+    return px + width * copies;
+}
