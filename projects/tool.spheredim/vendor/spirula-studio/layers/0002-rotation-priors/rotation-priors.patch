+#include "sfm/map/RotationCsvPriors.h"
+#include <cmath>
+#include <cstdio>
+#include <fstream>
+#include <stdexcept>
+using namespace sfm;
+int main() {
+    const char* file="/tmp/sfm-rotation-csv-test.csv";
+    const char* head="image,qw,qx,qy,qz,sigma_degrees\n";
+    { std::ofstream f(file); f << head << "cam0/0.png,1,0,0,0,1\ncam0/1.png,0.7071067811865476,0,0,0.7071067811865476,2\n"; }
+    RotationCsvPriors p(file,{"cam0/0","cam0/1"}); Mat3 R; double sigma=0;
+    if (!p.relativeRotation(0,1,R,sigma) || std::fabs(R[1]-1)>1e-8 || std::fabs(R[3]+1)>1e-8 || std::fabs(sigma-std::sqrt(5.0)*M_PI/180)>1e-8) return 1;
+    auto factors=p.factors({{0,0,{}},{1,0,{}}}); if (factors.rotations.size()!=1) return 2;
+    { std::ofstream f(file); f << head << "cam0/0.png,1,0,0,0,1\ncam0/1.png,1,0,0,0,1\ncam1/0.png,1,0,0,0,1\ncam1/1.png,1,0,0,0,1\n"; }
+    RigDef def; def.members.resize(2); def.members[0].prefix="cam0"; def.members[1].prefix="cam1";
+    std::vector<std::string> names={"cam0/0","cam0/1","cam1/0","cam1/1"};
+    RigTable rig=buildRigTable(names,{def});
+    RotationCsvPriors paired(file,names,&rig);
+    if (paired.factors({{0,0,{}},{1,0,{}},{2,0,{}},{3,0,{}}}).rotations.size()!=1 || !paired.neighbours(2).empty()) return 5;
+    { std::ofstream f(file); f << head << "cam0/0.png,1,0,0,0,1\ncam0/0.png,1,0,0,0,1\n"; }
+    try { RotationCsvPriors duplicate(file,{"cam0/0"}); return 3; } catch (const std::runtime_error&) {}
+    { std::ofstream f(file); f << head << "cam0/0.png,2,0,0,0,1\n"; }
+    try { RotationCsvPriors invalid(file,{"cam0/0"}); return 4; } catch (const std::runtime_error&) {}
+    std::remove(file); return 0;
+}
