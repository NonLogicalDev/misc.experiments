diff --git a/src/sfm/map/RotationCsvPriors.h b/src/sfm/map/RotationCsvPriors.h
new file mode 100644
index 0000000..d369d97
--- /dev/null
+++ b/src/sfm/map/RotationCsvPriors.h
@@ -0,0 +1,102 @@
+#pragma once
+// Camera-to-world rotation observations, stated per image in a common frame.
+#include <algorithm>
+#include <cmath>
+#include <fstream>
+#include <map>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+#include "sfm/core/PriorSource.h"
+#include "sfm/core/Rig.h"
+
+namespace sfm {
+class RotationCsvPriors : public PriorSource {
+    struct Row { Mat3 camera_from_world; double sigma = 0; };
+    std::vector<Row> rows_;
+    std::vector<std::vector<uint32_t>> neighbours_;
+public:
+    RotationCsvPriors(const std::string& path, const std::vector<std::string>& names, const RigTable* rigs = nullptr) {
+        std::ifstream f(path);
+        if (!f) throw std::runtime_error("cannot open rotation priors: " + path);
+        std::string line;
+        if (!std::getline(f, line) || line != "image,qw,qx,qy,qz,sigma_degrees")
+            throw std::runtime_error("rotation priors: invalid header");
+        std::map<std::string, Row> input;
+        while (std::getline(f, line)) {
+            if (!line.empty() && line.back() == '\r') line.pop_back();
+            std::vector<std::string> fields;
+            std::stringstream ss(line); std::string field;
+            while (std::getline(ss, field, ',')) fields.push_back(field);
+            if (fields.size() != 6 || fields[0].empty()) throw std::runtime_error("rotation priors: invalid row");
+            double v[5];
+            try {
+                for (int i=0; i<5; ++i) {
+                    size_t used = 0; v[i] = std::stod(fields[i+1], &used);
+                    if (used != fields[i+1].size() || !std::isfinite(v[i])) throw std::runtime_error("number");
+                }
+            } catch (...) { throw std::runtime_error("rotation priors: invalid number"); }
+            const double norm = std::sqrt(v[0]*v[0]+v[1]*v[1]+v[2]*v[2]+v[3]*v[3]);
+            if (std::fabs(norm-1.0)>1e-4 || !(v[4]>0)) throw std::runtime_error("rotation priors: invalid quaternion or sigma");
+            std::string key = fields[0];
+            const size_t dot = key.find_last_of('.'), slash = key.find_last_of('/');
+            if (dot != std::string::npos && (slash == std::string::npos || dot > slash)) key.erase(dot);
+            Row row{transpose(quaternionToRotation({v[0],v[1],v[2],v[3]})), v[4]*M_PI/180.0};
+            if (!input.emplace(key,row).second) throw std::runtime_error("rotation priors: duplicate image " + key);
+        }
+        rows_.resize(names.size()); neighbours_.resize(names.size());
+        std::map<std::string,std::vector<uint32_t>> groups;
+        for (uint32_t i=0; i<names.size(); ++i) {
+            auto it=input.find(names[i]);
+            if (it==input.end()) throw std::runtime_error("rotation priors: missing image " + names[i]);
+            rows_[i]=it->second;
+            const size_t slash=names[i].find_last_of('/');
+            groups[slash==std::string::npos ? "" : names[i].substr(0,slash)].push_back(i);
+            input.erase(it);
+        }
+        if (!input.empty()) throw std::runtime_error("rotation priors: unknown image " + input.begin()->first);
+        if (rigs) {
+            groups.clear();
+            for (uint32_t i=0; i<names.size(); ++i) {
+                RigSlot slot=rigs->slot(i);
+                if (!slot.valid()) {
+                    const size_t slash=names[i].find_last_of('/');
+                    groups[slash==std::string::npos ? "" : names[i].substr(0,slash)].push_back(i);
+                    continue;
+                }
+                const auto& frame=rigs->frameOf(slot);
+                uint32_t representative=kNoImage;
+                for (uint32_t member : frame) if (member!=kNoImage) { representative=member; break; }
+                if (representative==i) groups["rig:"+std::to_string(slot.rig)].push_back(i);
+            }
+        }
+        for (auto& group : groups) {
+            auto& ids=group.second;
+            std::sort(ids.begin(),ids.end(),[&](uint32_t a,uint32_t b){return names[a]<names[b];});
+            for (size_t i=0;i<ids.size();++i) {
+                if (i>0) neighbours_[ids[i]].push_back(ids[i-1]);
+                if (i+1<ids.size()) neighbours_[ids[i]].push_back(ids[i+1]);
+            }
+        }
+    }
+    bool competeVisualRotations() const override { return true; }
+    bool has(uint32_t i) const override { return i<rows_.size(); }
+    bool relativeRotation(uint32_t i,uint32_t j,Mat3& R,double& sigma) const override {
+        if (!has(i)||!has(j)) return false;
+        R=mul(rows_[j].camera_from_world,transpose(rows_[i].camera_from_world));
+        sigma=std::hypot(rows_[i].sigma,rows_[j].sigma); return true;
+    }
+    std::vector<uint32_t> neighbours(uint32_t i) const override { return has(i)?neighbours_[i]:std::vector<uint32_t>{}; }
+    PosePriors factors(const std::vector<PosedImage>& imgs) override {
+        PosePriors out; std::vector<bool> present(rows_.size(),false);
+        for (const auto& p : imgs) if (has(p.image)) present[p.image]=true;
+        for (const auto& p : imgs) if (has(p.image)) for (uint32_t j:neighbours_[p.image]) {
+            if (j<=p.image || !present[j]) continue;
+            PriorRotation r; r.i=p.image; r.j=j;
+            if (relativeRotation(r.i,r.j,r.R_ji,r.sigma)) out.rotations.push_back(r);
+        }
+        return out;
+    }
+};
+}
