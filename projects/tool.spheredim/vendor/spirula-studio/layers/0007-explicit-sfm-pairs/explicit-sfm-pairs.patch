diff --git a/src/sfm/feature/ExplicitPairs.h b/src/sfm/feature/ExplicitPairs.h
new file mode 100644
index 0000000..ccc436e
--- /dev/null
+++ b/src/sfm/feature/ExplicitPairs.h
@@ -0,0 +1,47 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <istream>
+#include <map>
+#include <stdexcept>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace sfm {
+
+// TSV uses exact relative image names, including extensions. Canonical image
+// indices are sorted and duplicates collapse, regardless of input direction.
+inline std::vector<std::pair<uint32_t, uint32_t>> readExplicitPairs(
+    std::istream& input, const std::vector<std::string>& image_names) {
+    std::map<std::string, uint32_t> ids;
+    for (uint32_t i = 0; i < image_names.size(); ++i)
+        if (image_names[i].empty() || !ids.emplace(image_names[i], i).second)
+            throw std::invalid_argument("image names must be nonempty and unique");
+    std::vector<std::pair<uint32_t, uint32_t>> pairs;
+    std::string line;
+    size_t number = 0;
+    while (std::getline(input, line)) {
+        ++number;
+        if (!line.empty() && line.back() == '\r') line.pop_back();
+        const size_t tab = line.find('\t');
+        if (tab == std::string::npos || tab == 0 || tab + 1 == line.size() ||
+            line.find('\t', tab + 1) != std::string::npos)
+            throw std::invalid_argument("pairs file line " + std::to_string(number) + " must contain two tab-separated image names");
+        const auto a = ids.find(line.substr(0, tab));
+        const auto b = ids.find(line.substr(tab + 1));
+        if (a == ids.end() || b == ids.end())
+            throw std::invalid_argument("pairs file line " + std::to_string(number) + " names an unknown image");
+        if (a->second == b->second)
+            throw std::invalid_argument("pairs file line " + std::to_string(number) + " is a self pair");
+        pairs.emplace_back(std::min(a->second, b->second), std::max(a->second, b->second));
+    }
+    if (input.bad()) throw std::runtime_error("error reading pairs file");
+    if (pairs.empty()) throw std::invalid_argument("pairs file is empty");
+    std::sort(pairs.begin(), pairs.end());
+    pairs.erase(std::unique(pairs.begin(), pairs.end()), pairs.end());
+    return pairs;
+}
+
+}  // namespace sfm
diff --git a/src/sfm/tests/sfm_explicit_pairs_test.cpp b/src/sfm/tests/sfm_explicit_pairs_test.cpp
new file mode 100644
index 0000000..f456255
--- /dev/null
+++ b/src/sfm/tests/sfm_explicit_pairs_test.cpp
@@ -0,0 +1,23 @@
+#include <cassert>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+#include "sfm/feature/ExplicitPairs.h"
+
+int main() {
+    const std::vector<std::string> names = {"cam0/a.png", "cam1/b.png", "cam 1/c.png"};
+    std::istringstream input("cam1/b.png\tcam0/a.png\ncam0/a.png\tcam1/b.png\ncam 1/c.png\tcam0/a.png\r\n");
+    const auto pairs = sfm::readExplicitPairs(input, names);
+    assert((pairs == std::vector<std::pair<uint32_t,uint32_t>>{{0,1},{0,2}}));
+    for (const std::string& bad : {"", "cam0/a.png\tcam0/a.png\n", "cam0/a.png\tmissing.png\n", "cam0/a.png cam1/b.png\n", "cam0/a.png\tcam1/b.png\textra\n"}) {
+        std::istringstream stream(bad);
+        bool rejected = false;
+        try { (void)sfm::readExplicitPairs(stream, names); } catch (const std::invalid_argument&) { rejected = true; }
+        assert(rejected);
+    }
+    std::istringstream duplicate_names("a\tb\n");
+    bool rejected = false;
+    try { (void)sfm::readExplicitPairs(duplicate_names, {"a", "a", "b"}); } catch (const std::invalid_argument&) { rejected = true; }
+    assert(rejected);
+}
