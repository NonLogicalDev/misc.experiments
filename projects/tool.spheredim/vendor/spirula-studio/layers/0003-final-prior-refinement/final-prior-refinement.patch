@@ -0,0 +1,26 @@
+#pragma once
+// Prove that the final fixed-rig solve carries every registered body frame
+// and its available relative rotation factors; it does not assess accuracy.
+#include <stdexcept>
+#include <vector>
+#include "sfm/ba/Priors.h"
+
+namespace sfm {
+inline void validateFinalPriorLayout(const BAProblem& p, const PosePriors& priors,
+                                     uint32_t images, uint32_t frames, size_t factors) {
+    if (p.num_images != images || p.num_frames != frames || p.image_frame.size() != images)
+        throw std::runtime_error("final prior BA omitted registered images or body frames");
+    if (p.ext_dim != 0)
+        throw std::runtime_error("final prior BA would refine rig extrinsics");
+    if (priors.rotations.size() != factors)
+        throw std::runtime_error("final prior BA omitted rotation factors");
+    std::vector<bool> covered(frames, false);
+    for (const PriorRotation& r : priors.rotations) {
+        if (r.i >= images || r.j >= images || p.image_frame[r.i] >= frames || p.image_frame[r.j] >= frames)
+            throw std::runtime_error("final prior BA has an invalid factor index");
+        covered[p.image_frame[r.i]] = covered[p.image_frame[r.j]] = true;
+    }
+    for (bool value : covered)
+        if (!value) throw std::runtime_error("final prior BA has a body frame without a rotation factor");
+}
+}
