@@ -0,0 +1,19 @@
+#include "sfm/map/FinalPriorValidation.h"
+#include <stdexcept>
+using namespace sfm;
+int main() {
+    BAProblem p; p.num_images=4; p.num_frames=2; p.image_frame={0,0,1,1};
+    PosePriors q; PriorRotation r; r.i=0; r.j=2; q.rotations.push_back(r);
+    validateFinalPriorLayout(p,q,4,2,1);
+    auto rejects=[&](const BAProblem& b,const PosePriors& x,uint32_t images,uint32_t frames,size_t count) {
+        try { validateFinalPriorLayout(b,x,images,frames,count); return false; }
+        catch (const std::runtime_error&) { return true; }
+    };
+    if (!rejects(p,q,5,2,1)) return 1;
+    if (!rejects(p,q,4,2,2)) return 2;
+    BAProblem loose=p; loose.ext_dim=1; if (!rejects(loose,q,4,2,1)) return 3;
+    PosePriors empty; if (!rejects(p,empty,4,2,0)) return 4;
+    BAProblem third=p; third.num_frames=3; third.image_frame={0,0,1,2};
+    if (!rejects(third,q,4,3,1)) return 5;
+    return 0;
+}
