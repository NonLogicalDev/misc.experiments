+#[test]
+fn camera_frame_readout_recovers_forward_sensor_sphere() {
+    use insta360_rs::motion::ReadoutDirection;
+    let cpu = CpuStitcher::new();
+    // Both sensors sweep top to bottom. The second phase represents a known
+    // exposure-center delay, not an invented lens rotation or target frame.
+    for (angle, secondary_phase) in [(0.0, 0.0), (0.3, 0.0), (0.3, 0.03)] {
+        let scans = [0.0, secondary_phase].map(|phase| rolling_shutter::Scan {
+            direction: ReadoutDirection::TopToBottom,
+            crop: [0.0, 1.0],
+            angle,
+            phase,
+        });
+        let chart = rolling_shutter::chart(scans, [17.0, -23.0, 41.0], [17.0, -23.0, 41.0]);
+        let rendered = cpu
+            .stitch_with_motion(
+                &chart.lenses,
+                &chart.calibration,
+                chart.projection,
+                &chart.motion,
+            )
+            .unwrap();
+        let (mean, max) = rolling_shutter::error(&rendered, &chart.expected);
+        assert!(
+            mean < 0.3 && max <= 2,
+            "camera-frame sphere error mean={mean} max={max}"
+        );
+        if angle > 0.0 {
+            let uncorrected = cpu
+                .stitch_with_orientation(
+                    &chart.lenses,
+                    &chart.calibration,
+                    chart.projection,
+                    chart.motion.correction(),
+                )
+                .unwrap();
+            let (error, _) = rolling_shutter::error(&uncorrected, &chart.expected);
+            assert!(
+                error > 1.0 && mean * 8.0 < error,
+                "row correction did not remove the generated skew: {mean} vs {error}"
+            );
+        }
+    }
