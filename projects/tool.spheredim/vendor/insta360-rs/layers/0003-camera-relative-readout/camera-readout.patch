+    #[test]
+    fn camera_frame_readout_source_coordinates_match_analytic_yaw() {
+        use crate::motion::{ReadoutDirection, ReadoutPoseTable};
+        struct CoordinateSource;
+        impl ProjectionSource for CoordinateSource {
+            fn dimensions(&self) -> (u32, u32) {
+                (256, 256)
+            }
+            fn sample_inside(&self, x: f64, y: f64, _: Option<&FisheyeMask>) -> [f64; 3] {
+                [x, y, 0.0]
+            }
+        }
+        let calibration = synthetic_dual_fisheye_calibration(256, 256).unwrap();
+        let theta: f64 = 0.2;
+        // Rotation about each optical Y axis leaves the projected source row
+        // at exactly 128; an equidistant lens then gives x = 128 + f * angle.
+        // This analytic one-dimensional result does not call the projector.
+        let fraction = (128.0 + 0.5) / 256.0;
+        for (index, phase) in [(0, 0.0), (1, 0.03)] {
+            let lens = &calibration.lenses[index];
+            let axis = lens.orientation.inverse().rotate_vector([0.0, 1.0, 0.0]);
+            let table = ReadoutPoseTable::new(
+                ReadoutDirection::TopToBottom,
+                [0.0, 1.0],
+                [0.0, 1.0]
+                    .into_iter()
+                    .map(|t| Orientation::from_axis_angle(axis, phase + 0.3 * (t - 0.5)).unwrap())
+                    .collect(),
+            )
+            .unwrap();
+            let ray = lens
+                .orientation
+                .inverse()
+                .rotate_vector([theta.sin(), 0.0, theta.cos()]);
+            let sample = project_and_sample(
+                &CoordinateSource,
+                lens,
+                index,
+                ray,
+                0.0,
+                None,
+                None,
+                Some(&table),
+            )
+            .unwrap();
+            let expected_x = 128.0 + lens.fx * (theta + phase + 0.3 * (fraction - 0.5));
+            assert!((sample.source_x - expected_x).abs() < 1e-7);
+            assert!((sample.source_y - 128.0).abs() < 1e-7);
+            assert!((sample.color[0] - expected_x).abs() < 1e-7);
+        }
+    }
 
