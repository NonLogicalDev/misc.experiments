+#[test]
+fn gpu_camera_frame_readout_recovers_forward_sensor_sphere() {
+    use insta360_rs::motion::ReadoutDirection;
+    if !gpu_available_or_skip() {
+        return;
+    }
+    let gpu = insta360_rs::gpu::GpuStitcher::new().expect("GPU renderer");
+    let adapter = gpu.adapter_info();
+    // This targeted qualification requires real GPU execution, not software
+    // Vulkan or the automatic CPU fallback used by higher-level APIs.
+    assert_ne!(
+        adapter.device_type, "Cpu",
+        "camera-frame fixture needs a physical GPU"
+    );
+    let cpu = CpuStitcher::new();
+    for (angle, secondary_phase) in [(0.0, 0.0), (0.3, 0.0), (0.3, 0.03)] {
+        let scans = [0.0, secondary_phase].map(|phase| rolling_shutter::Scan {
+            direction: ReadoutDirection::TopToBottom,
+            crop: [0.0, 1.0],
+            angle,
+            phase,
+        });
+        let chart = rolling_shutter::chart(scans, [17.0, -23.0, 41.0], [17.0, -23.0, 41.0]);
+        let actual = gpu
+            .stitch_with_motion(
+                &chart.lenses,
+                &chart.calibration,
+                chart.projection,
+                &chart.motion,
+            )
+            .unwrap();
+        let cpu_result = cpu
+            .stitch_with_motion(
+                &chart.lenses,
+                &chart.calibration,
+                chart.projection,
+                &chart.motion,
+            )
+            .unwrap();
+        let (mean, max) = rolling_shutter::error(&actual, &chart.expected);
+        assert!(
+            mean < 0.3 && max <= 2,
+            "GPU camera-frame sphere error mean={mean} max={max}"
+        );
+        let difference = sorted_channel_differences(actual.as_rgb8(), cpu_result.as_rgb8());
+        assert!(*difference.last().unwrap() <= 1, "CPU/GPU image mismatch");
+        if angle > 0.0 {
+            let uncorrected = gpu
+                .stitch_with_orientation(
+                    &chart.lenses,
+                    &chart.calibration,
+                    chart.projection,
+                    chart.motion.correction(),
+                )
+                .unwrap();
+            let (error, _) = rolling_shutter::error(&uncorrected, &chart.expected);
+            assert!(
+                error > 1.0 && mean * 8.0 < error,
+                "row correction did not remove generated skew: {mean} vs {error}"
+            );
+        }
+    }
