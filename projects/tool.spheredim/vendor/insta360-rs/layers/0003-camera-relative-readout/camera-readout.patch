+#[test]
+fn gpu_camera_frame_readout_preserves_source_coordinate_texture() {
+    use insta360_rs::motion::ReadoutDirection;
+    if !gpu_available_or_skip() {
+        return;
+    }
+    let gpu = insta360_rs::gpu::GpuStitcher::new().expect("GPU renderer");
+    assert_ne!(
+        gpu.adapter_info().device_type,
+        "Cpu",
+        "physical GPU required"
+    );
+    let cpu = CpuStitcher::new();
+    let scans = [0.0, 0.03].map(|phase| rolling_shutter::Scan {
+        direction: ReadoutDirection::TopToBottom,
+        crop: [0.0, 1.0],
+        angle: 0.3,
+        phase,
+    });
+    let chart = rolling_shutter::chart(scans, [17.0, -23.0, 41.0], [17.0, -23.0, 41.0]);
+    // Red and green encode decoded source x and y directly. Thus a
+    // CPU/GPU channel difference reflects source-coordinate or sampling
+    // disagreement, including the two independently projected lenses.
+    let lenses = std::array::from_fn(|lens| {
+        let mut rgb = Vec::with_capacity(256 * 256 * 3);
+        for y in 0..256_u32 {
+            for x in 0..256_u32 {
+                rgb.extend_from_slice(&[x as u8, y as u8, (lens * 127) as u8]);
+            }
+        }
+        LensFrame::new(256, 256, rgb).unwrap()
+    });
+    let a = cpu
+        .stitch_with_motion(&lenses, &chart.calibration, chart.projection, &chart.motion)
+        .unwrap();
+    let b = gpu
+        .stitch_with_motion(&lenses, &chart.calibration, chart.projection, &chart.motion)
+        .unwrap();
+    let diff = sorted_channel_differences(a.as_rgb8(), b.as_rgb8());
+    assert!(
+        *diff.last().unwrap() <= 2,
+        "source-coordinate texture differs across backends"
+    );
+}
