load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/bazel:interview_rules.bzl", "go_interview")

go_interview(
    name = "interview",
    main_file = "main.go",
)

go_library(
    name = "lib",
    srcs = ["main.go"],
    importpath = "",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "go",
    embed = [":lib"],
    visibility = ["//visibility:public"],
)
