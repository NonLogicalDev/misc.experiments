# ------------------------------------------------------------------------------
# NIX Environment Setup
# ------------------------------------------------------------------------------

# NIX: ensure we reload direnv whenever any file changes in ./.nix dir.
watch_file .nix/**/*

# NIX: ensure nix-direnv is loaded
#   (if present, it is faster and smarter than built-in supplied as part of stdenv).
if [[ -e "$HOME/.nix-profile/share/nix-direnv/direnvrc" ]]; then
  source $HOME/.nix-profile/share/nix-direnv/direnvrc
fi

# NIX: initialize nix environment.
#   (use path rather than git integration, this is a simpler setup for ad-hoc usecases,
#     i.e not dedicated flake enabled repos)
use flake path:./.nix

# ------------------------------------------------------------------------------