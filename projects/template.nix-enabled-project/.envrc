# ------------------------------------------------------------------------------
# NIX Environment Setup
# ------------------------------------------------------------------------------
NIX_DIRENVRC="$HOME/.nix-profile/share/nix-direnv/direnvrc"
[[ -e "$NIX_DIRENVRC" ]] && source "$NIX_DIRENVRC"

# NIX: ensure we reload direnv whenever any file changes in ./.nix dir.
watch_file .nix/**/*

# NIX: initialize nix environment. 
#   (use path rather than git integration, this is a simpler setup for ad-hoc usecases, 
#     i.e not dedicated flake enabled repos)
use flake path:./.nix

# ------------------------------------------------------------------------------