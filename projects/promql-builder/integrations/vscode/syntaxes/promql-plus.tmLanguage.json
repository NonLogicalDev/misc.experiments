{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PromQL+",
  "scopeName": "source.promql-plus",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#sugar-functions" },
    { "include": "#binary-op-functions" },
    { "include": "#aggregations" },
    { "include": "#functions" },
    { "include": "#keywords" },
    { "include": "#references" },
    { "include": "#durations" },
    { "include": "#metric-selectors" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.promql-plus",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.promql-plus",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.promql-plus",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.promql-plus",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.promql-plus",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.assignment.promql-plus",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.promql-plus",
          "match": "[+\\-*/%^]"
        }
      ]
    },
    "sugar-functions": {
      "patterns": [
        {
          "name": "entity.name.function.sugar.promql-plus",
          "match": "~(rate|offset|at|at_start|at_end|resample|sum|avg|min|max|count|bottomk|topk)\\b"
        }
      ]
    },
    "binary-op-functions": {
      "patterns": [
        {
          "name": "entity.name.function.binary-op.promql-plus",
          "match": ":(add|sub|mul|div|mod|pow)\\b"
        }
      ]
    },
    "aggregations": {
      "patterns": [
        {
          "name": "support.function.aggregation.promql-plus",
          "match": "\\b(sum|avg|min|max|count|stddev|stdvar|topk|bottomk|quantile|count_values|group)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.promql-plus",
          "match": "\\b(rate|increase|histogram_quantile|clamp_max|clamp_min|round|ceil|floor|abs|sort|sort_desc)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.promql-plus",
          "match": "\\b(let|by|without|wo|on|ignoring|group_left|group_right|offset|@|start|end)\\b"
        }
      ]
    },
    "references": {
      "patterns": [
        {
          "name": "variable.other.reference.promql-plus",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "variable.language.placeholder.promql-plus",
          "match": "\\$(?![a-zA-Z_])"
        }
      ]
    },
    "durations": {
      "patterns": [
        {
          "name": "constant.numeric.duration.promql-plus",
          "match": "\\b\\d+[smhdwy]\\b"
        }
      ]
    },
    "metric-selectors": {
      "patterns": [
        {
          "name": "meta.metric-selector.promql-plus",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            { "include": "#strings" },
            {
              "name": "keyword.operator.comparison.promql-plus",
              "match": "(=~|!~|!=|=)"
            },
            {
              "name": "entity.name.tag.label.promql-plus",
              "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
            }
          ]
        }
      ]
    }
  }
}
