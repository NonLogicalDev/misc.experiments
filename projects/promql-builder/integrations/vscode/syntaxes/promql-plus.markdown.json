{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PromQL+ Markdown Injection",
  "scopeName": "markdown.promql-plus.codeblock",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    {
      "include": "#fenced-promql-plus"
    }
  ],
  "repository": {
    "fenced-promql-plus": {
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(promql\\+|promql-plus|pql)((\\s+|:|,|\\{|\\?)[^`~]*)?$)",
      "name": "markup.fenced_code.block.markdown",
      "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
      "beginCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        },
        "4": {
          "name": "fenced_code.block.language.markdown"
        }
      },
      "endCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        }
      },
      "patterns": [
        {
          "include": "source.promql-plus"
        }
      ]
    }
  }
}
