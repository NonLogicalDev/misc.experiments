let root_scope = container_memory_rss{id="/", instance="cadvisor:8080", job="cadvisor"};
let system_slice = container_memory_rss{id="/system.slice", instance="cadvisor:8080", job="cadvisor"};

#compute percentage of system slice in root scope
($system_slice | ~resample(5m, 10m) | ~rate | ~resample(1m, 1m)) 
/ 
($root_scope | ~resample(5m, 10m) | ~rate | ~resample(1m, 1m)) * 100