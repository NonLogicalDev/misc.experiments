 use super::*;
 
+#[test]
+fn boundary_side_labels_use_node_indices_and_refuse_ambiguous_loops() {
+    let uv = vec![[0., 0.], [1., 0.], [1., 1.], [0., 1.]];
+    let points: Vec<Vec3> = uv.iter().map(|q| Vec3::new(q[0], q[1], 0.)).collect();
+    let boundary = Boundary {
+        loops: vec![seam::Loop { uv: uv.clone(), pts: points.clone() }],
+        segments: vec![vec![(0, 0), (0, 1), (2, 0), (3, 0)]],
+        reach: 0.,
+    };
+    let mut face = FacePlan {
+        uv,
+        fixed: points.into_iter().map(kernel::record_vec3).collect(),
+        triangles: vec![[0, 1, 2], [0, 2, 3]],
+        ..FacePlan::default()
+    };
+    assert_eq!(boundary_triangle_edges(&boundary, &face), Some(vec![[Some((0, 0)), Some((0, 1)), None], [None, Some((2, 0)), Some((3, 0))]]));
+    // A flipped face must retain the same edge on the corresponding side.
+    face.triangles = vec![[0, 2, 1], [0, 3, 2]];
+    assert_eq!(boundary_triangle_edges(&boundary, &face), Some(vec![[None, Some((0, 1)), Some((0, 0))], [Some((3, 0)), Some((2, 0)), None]]));
+    face.uv[2] = face.uv[1];
+    assert_eq!(boundary_triangle_edges(&boundary, &face), None);
+    face.uv[2] = [1., 1.];
+    face.triangles.pop();
+    assert_eq!(boundary_triangle_edges(&boundary, &face), None);
+}
