+/// Match final triangle sides to the prepared boundary by local node index.
+/// Return none when polygon construction moved, duplicated or cut the loop,
+/// or when the triangle mesh does not account for each boundary side exactly
+/// once. In particular this refuses coincident loop nodes and repeated uses.
+fn boundary_triangle_edges(boundary: &Boundary, face: &FacePlan) -> Option<Vec<[Option<(u32, u32)>; 3]>> {
+    use std::collections::HashSet;
+    let mut pairs: HashMap<(u32, u32), (u32, u32)> = HashMap::new();
+    let mut uv_seen = HashSet::new();
+    let mut point_seen = HashSet::new();
+    let mut segment_seen = HashSet::new();
+    let mut offset = 0usize;
+    let pair = |a: u32, b: u32| (a.min(b), a.max(b));
+    for (lp, segments) in boundary.loops.iter().zip(&boundary.segments) {
+        let n = lp.uv.len();
+        if n < 3 || lp.pts.len() != n || segments.len() != n { return None; }
+        for k in 0..n {
+            let uv = lp.uv.get(k)?;
+            let p = lp.pts.get(k)?;
+            let seg = *segments.get(k)?;
+            let i = offset.checked_add(k)?;
+            if face.uv.get(i)? != uv || face.fixed.get(i)? != &kernel::record_vec3(*p)
+                || !uv_seen.insert(uv.map(|v| (v + 0.0).to_bits()))
+                || !point_seen.insert([p.x, p.y, p.z].map(|v| (v + 0.0).to_bits()))
+                || !segment_seen.insert(seg)
+            { return None; }
+            let a = u32::try_from(i).ok()?;
+            let b = u32::try_from(offset.checked_add((k + 1) % n)?).ok()?;
+            if pairs.insert(pair(a, b), seg).is_some() { return None; }
+        }
+        offset = offset.checked_add(n)?;
+    }
+    if boundary.loops.len() != boundary.segments.len() || offset != face.fixed.len() || pairs.is_empty() { return None; }
+    let mut uses: HashMap<(u32, u32), usize> = HashMap::new();
+    let mut mapped = Vec::with_capacity(face.triangles.len());
+    for &[a, b, c] in &face.triangles {
+        if a == b || b == c || c == a || [a, b, c].iter().any(|&i| (i as usize) >= face.uv.len()) { return None; }
+        let sides = [pair(a, b), pair(b, c), pair(c, a)];
+        for side in sides { *uses.entry(side).or_default() += 1; }
+        mapped.push(sides.map(|side| pairs.get(&side).copied()));
+    }
+    if pairs.keys().any(|side| uses.get(side) != Some(&1))
+        || uses.iter().any(|(side, n)| *n != if pairs.contains_key(side) { 1 } else { 2 })
+    { return None; }
+    Some(mapped)
+}
