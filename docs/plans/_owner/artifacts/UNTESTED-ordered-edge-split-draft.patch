+/// A split body and the two actual children, indexed by its accompanying order.
+/// The children are in kernel reused/new order, not a geometric direction.
+pub struct EdgeSplit {
+    pub body: Body,
+    pub record: solidcore_record::brep::Brep,
+    pub order: Order,
+    pub edges: [usize; 2],
+}
+
+/// Split a record edge at a strictly interior curve parameter on a private copy.
+///
+/// `expected` and `order` must belong to `body`; equal numeric handles cannot
+/// establish body ownership. Callback errors detected by the scoped audit and
+/// kernel refusals discard the copy. This does not assign persistent identities.
+pub fn edge_ordered(
+    body: &Body,
+    expected: &solidcore_record::brep::Brep,
+    order: &Order,
+    edge: usize,
+    parameter: f64,
+) -> Result<EdgeSplit> {
+    if !parameter.is_finite() {
+        return Err(Error::Argument);
+    }
+    let (record, current) = body.to_record()?;
+    if &record != expected || current.faces != order.faces || current.edges != order.edges
+        || current.vertices != order.vertices
+    {
+        return Err(Error::Argument);
+    }
+    let interval = record.edges.get(edge).ok_or(Error::Argument)?.interval;
+    if parameter <= interval[0] || parameter >= interval[1] {
+        return Err(Error::Argument);
+    }
+    let (copy, mapped) = body.copy_with_order(order)?;
+    let (copied_record, _) = copy.to_record()?;
+    if copied_record != record {
+        return Err(Error::Argument);
+    }
+    let selected = *mapped.edges.get(edge).ok_or(Error::Argument)?;
+    let (result, failed) = crate::provenance::with_failure_audit(|| {
+        crate::session::with_body("split edge", &copy, |k, b| {
+            let output = solidcore::topology::brep::p9::split_edge_with_attributes(k, b, selected, parameter)?;
+            Ok(if output.split { output.edges.ok_or(Error::NoEffect) } else { Err(Error::NoEffect) })
+        })
+    })?;
+    if failed {
+        return Err(Error::Unsupported("split provenance callback failed"));
+    }
+    let children = result??;
+    let (record, order) = copy.to_record()?;
+    let find = |child| order.edges.iter().position(|edge| *edge == child).ok_or(Error::NoEffect);
+    let edges = [find(children[0])?, find(children[1])?];
+    if edges[0] == edges[1] {
+        return Err(Error::NoEffect);
+    }
+    Ok(EdgeSplit { body: copy, record, order, edges })
+}
