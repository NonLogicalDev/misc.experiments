+/// Split an edge while carrying the B-rep's own application attributes through
+/// the real kernel notification context. The caller owns rollback on failure.
+pub fn split_edge_with_attributes(
+    k: &mut Kernel,
+    b: &mut Brep,
+    edge_id: EdgeId,
+    parameter: f64,
+) -> Result<SplitEdgeOutput> {
+    let mut state = crate::topology::brep::p2::ArenaNotifyState::with_attributes_of(b);
+    let was_editing = b.editing_enabled();
+    b.set_editing_enabled(true);
+    let result = make_vertex_split_edge_with_kernel_curve_identity(
+        k,
+        b,
+        edge_id,
+        parameter,
+        &mut edge::NotificationStores {
+            records: &mut state.records,
+            attributes: &mut state.attributes,
+            key_of: &crate::topology::loopuse::notify_ref,
+        },
+        CurveIdentity::Actual(&issue_curve_identity),
+    );
+    b.set_editing_enabled(was_editing);
+    state.restore_attributes(b)?;
+    b.refresh_cached_topology();
+    result
+}
